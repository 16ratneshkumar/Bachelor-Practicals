PYTHON = python

all: help

help:
	@echo "Use 'make p1' to run practical1.py"
	@echo "Use 'make p2' to run practical2.py"
	@echo "...and so on up to p11."

p1:
	$(PYTHON) practical1.py

p2:
	$(PYTHON) practical2.py

p3:
	$(PYTHON) practical3.py

p4:
	$(PYTHON) practical4.py

p5:
	$(PYTHON) practical5.py

p6:
	$(PYTHON) practical6.py

p7:
	$(PYTHON) practical7.py

p8:
	$(PYTHON) practical8.py

p9:
	$(PYTHON) practical9.py

p10:
	$(PYTHON) practical10.py

p11:
	$(PYTHON) practical11.py

clean:
	rm -rf __pycache__
	rm -f *.pyc
